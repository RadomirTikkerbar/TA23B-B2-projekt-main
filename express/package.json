{
  "name": "express",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "nodemon index.js",
    "prestart": "prisma generate",
    "start": "node index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && prisma db seed",
    "db:setup": "prisma generate && prisma migrate dev && prisma db seed",
    "test": "vitest --globals",
    "coverage": "vitest --coverage --run --globals"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-mariadb": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@prisma/extension-accelerate": "3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.2.3",
    "@vitest/coverage-v8": "^4.1.1",
    "prisma": "^7.4.0",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.1"
  }
}
